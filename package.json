{
  "name": "kalambury",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Kalambury 1 na 1 – aplikacja PWA na telefon",
  "scripts": {
    "dev": "npm run icons && vite --host",
    "build": "npm run icons && tsc -b && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc -b",
    "peer-server": "node scripts/dev-peer-server.mjs",
    "test:e2e": "npm run icons && node e2e/run.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "peer": "^1.0.2",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
