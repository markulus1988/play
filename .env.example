# Wszystkie zmienne są opcjonalne – bez nich gra korzysta z publicznego
# serwera łączenia PeerJS i publicznych serwerów STUN.

# Własny serwer łączenia (sygnalizacji) PeerJS
# VITE_PEER_HOST=peer.twojadomena.pl
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Serwer TURN – potrzebny tylko wtedy, gdy telefony w sieci komórkowej
# nie potrafią zestawić połączenia bezpośredniego.
# VITE_TURN_URL=turn:turn.twojadomena.pl:3478
# VITE_TURN_USERNAME=uzytkownik
# VITE_TURN_CREDENTIAL=haslo
